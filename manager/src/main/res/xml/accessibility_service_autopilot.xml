<?xml version="1.0" encoding="utf-8"?>
<!--
    Config for PairingAutopilotService.

    Scoped to `com.android.settings` (the phone/tablet Settings app), which is distinct
    from this fork's existing accessibility_service_config.xml — that one scopes
    AdbPairingAccessibilityService to `com.android.tv.settings` and is TV-only. The two
    services target different packages and never compete for the same screen.

    Differs from the TV config in three ways, all required for driving the UI rather than
    just watching it:
      - typeWindowContentChanged: Settings updates rows in place (e.g. the Build number
        countdown) without a full window state change.
      - flagReportViewIds: lets us fall back to view-id matching when label text differs.
      - canPerformGestures: reserved for coordinate taps on ROMs where no clickable
        ancestor is exposed. Node clicks are preferred and tried first.
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/autopilot_service_description"
    android:summary="@string/autopilot_service_summary"
    android:accessibilityEventTypes="typeWindowStateChanged|typeWindowContentChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagDefault|flagRetrieveInteractiveWindows|flagIncludeNotImportantViews|flagReportViewIds"
    android:packageNames="com.android.settings"
    android:canPerformGestures="true"
    android:canRetrieveWindowContent="true"
    android:notificationTimeout="100" />
